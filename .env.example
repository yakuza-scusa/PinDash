NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Comma-separated trusted proxy IPs/CIDRs; keep blank for direct local access.
TRUST_PROXY=
DATABASE_URL=postgresql://pindash:pindash@localhost:5432/pindash?schema=public
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
SESSION_COOKIE_NAME=pindash_session
SESSION_TTL_DAYS=30

PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:4000/api/v1/pinterest/oauth/callback
PINTEREST_API_BASE_URL=https://api-sandbox.pinterest.com/v5
PINTEREST_OAUTH_BASE_URL=https://www.pinterest.com/oauth
PINTEREST_SCOPES=boards:read,pins:read,pins:write

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pindash-media
S3_ACCESS_KEY=pindash
S3_SECRET_KEY=replace-in-real-environments
S3_FORCE_PATH_STYLE=true
