# PinDash + Supabase free-plan configuration
# Copy the required values into the deployment platform's secret manager.
# Never commit real passwords, S3 keys, Pinterest credentials, or encryption keys.

NODE_ENV=production
WEB_URL=https://your-web-host.example
PUBLIC_API_URL=https://your-api-host.example
NEXT_PUBLIC_API_URL=https://your-api-host.example/api/v1
TRUST_PROXY=127.0.0.1

# Use the Supavisor Session pooler URI from Supabase > Connect (port 5432).
# Add sslmode=require and keep a small Prisma pool on the free plan.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require&connection_limit=5

# Supabase does not replace Redis/BullMQ. Use an external TLS Redis service.
REDIS_URL=rediss://default:REDIS_PASSWORD@REDIS_HOST:6379

SESSION_SECRET=generate-at-least-32-random-bytes
TOKEN_ENCRYPTION_KEY=generate-32-byte-base64-key
SESSION_COOKIE_NAME=pindash_session
SESSION_TTL_DAYS=30

PINTEREST_CLIENT_ID=your-trial-app-id
PINTEREST_CLIENT_SECRET=your-trial-app-secret
PINTEREST_REDIRECT_URI=https://your-api-host.example/api/v1/pinterest/oauth/callback
PINTEREST_API_BASE_URL=https://api.pinterest.com/v5
PINTEREST_OAUTH_BASE_URL=https://www.pinterest.com/oauth
PINTEREST_SCOPES=boards:read,pins:read,pins:write,user_accounts:read

# Enable S3 access in Supabase Storage, create a private `pindash-media`
# bucket, and generate an S3 access-key pair. The endpoint contains PROJECT_REF.
S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION=PROJECT_REGION
S3_BUCKET=pindash-media
S3_ACCESS_KEY=your-supabase-s3-access-key
S3_SECRET_KEY=your-supabase-s3-secret-key
S3_FORCE_PATH_STYLE=true

AUTH_EMAIL_FROM=PinDash <auth@your-domain.example>
RESEND_API_KEY=optional-until-production-passwordless-email
