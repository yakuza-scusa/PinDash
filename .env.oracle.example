NODE_ENV=production
PORT=4000
TRUST_PROXY=true

WEB_URL=https://app.comparatif-devis.fr
PUBLIC_API_URL=https://api.comparatif-devis.fr
API_URL=http://api:4000

DATABASE_URL=provided-by-supabase-session-pooler
REDIS_URL=provided-by-upstash

S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION=eu-west-1
S3_BUCKET=pindash-media
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=provided-by-supabase
S3_SECRET_KEY=provided-by-supabase

SESSION_COOKIE_NAME=pindash_session
SESSION_SECRET=generate-a-strong-random-secret
SESSION_TTL_DAYS=30
TOKEN_ENCRYPTION_KEY=generate-a-32-byte-base64-key

PINTEREST_CLIENT_ID=provided-by-pinterest
PINTEREST_CLIENT_SECRET=provided-by-pinterest
PINTEREST_REDIRECT_URI=https://api.comparatif-devis.fr/api/v1/pinterest/oauth/callback
PINTEREST_SCOPES=boards:read,pins:read,pins:write
PINTEREST_API_BASE_URL=https://api.pinterest.com/v5
PINTEREST_OAUTH_BASE_URL=https://www.pinterest.com/oauth

RESEND_API_KEY=provided-by-resend
AUTH_EMAIL_FROM=PinDash <login@auth.comparatif-devis.fr>
